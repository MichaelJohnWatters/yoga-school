# Local HTTPS reverse proxy for dev.
#
# Why this file exists:
#   Browsers gate several behaviours on real HTTPS (service workers in
#   prod-shape, secure cookies, HTTP/2 negotiation, OAuth redirect
#   targets, …). Localhost gets a partial pass for some of them, but the
#   only way to get true dev/prod parity is to actually terminate TLS in
#   front of the dev stack. This Caddyfile does that AND collapses the
#   API + Flutter dev server onto one origin, which also makes every
#   `OPTIONS` preflight (CORS) disappear since requests stop being
#   cross-origin.
#
# How to use:
#   1. One-time per machine: `brew install mkcert caddy && mkcert -install`
#   2. One-time per checkout: `(cd dev-certs && mkcert localhost 127.0.0.1 ::1)`
#   3. Run: `make caddy` (foreground) or `tilt up` (Tilt runs it for you)
#   4. App URL: https://localhost:5443
#
# Port 5443 (not 443) so binding doesn't need sudo. The trade-off is
# the visible port suffix in URLs; the parity wins still hold.

{
	auto_https off
	admin off
	# INFO surfaces per-request access logs (method, path, status, ms)
	# in the Tilt yoga-caddy pane. Yes it duplicates the Go request log
	# for /api/* hops, but seeing the Caddy side is what tells you
	# whether the proxy is even reached + whether HTTP/2 is negotiated
	# — and the duplication is worth that visibility in dev.
	log {
		output stderr
		level INFO
	}
}

https://localhost:5443 {
	tls dev-certs/localhost+2.pem dev-certs/localhost+2-key.pem

	# API → Go server on :8080. Path-prefix routing means everything
	# under /api/* flows through, which matches the chi router's mount
	# point so URLs are unchanged from the app's perspective.
	handle_path /api/* {
		reverse_proxy localhost:8080 {
			# Pass the original path through so the Go router sees
			# `/api/v1/...` (handle_path strips the leading `/api`, so
			# we have to put it back).
			rewrite /api{uri}
		}
	}

	# Firebase Storage emulator download endpoint → :9199. Media images
	# (splash, etc.) are served from this same https origin so the browser
	# doesn't block the emulator's plain-http URL as mixed content. Paired
	# with MEDIA_PUBLIC_URL_BASE=https://localhost:5443 on the server, which
	# builds the download URLs against this origin. Dev-only; prod serves
	# from firebasestorage.googleapis.com directly.
	handle /v0/* {
		reverse_proxy localhost:9199
	}

	# Everything else → Flutter web dev server on :5173. Caddy handles
	# WebSocket upgrades natively, so hot reload keeps working over the
	# proxied connection.
	handle {
		reverse_proxy localhost:5173
	}
}
